{
  "name": "loanforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "src/api",
    "web"
  ],
  "scripts": {
    "api": "npm run start:dev --workspace=src/api",
    "web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=src/api && npm run build --workspace=web",
    "test": "npm test --workspace=src/api",
    "seed": "npm run build --workspace=src/api && node --experimental-strip-types scripts/seed.ts",
    "review-agent": "node --experimental-strip-types scripts/run-review-agent.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "better-sqlite3": "^12.11.1",
    "typeorm": "^1.1.1"
  }
}
